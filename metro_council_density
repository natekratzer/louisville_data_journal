## City v County Calculations

Join the shapefiles

```{r}
districts <- st_transform(districts, crs = 3089)
city_boundaries <- st_transform(city_boundaries, crs = 3089)
acs_data <- st_transform(acs_data, crs = 3089)  # Kentucky State Plane (feet)


#Calculate area of each district, city, and tract
districts <- districts |>
    mutate(district_area = st_area(geometry))

city_boundaries <- city_boundaries |>
    mutate(city_area = st_area(geometry))

acs_data <- acs_data |>
  mutate(tract_area = st_area(geometry))

#Intersect them all with city boundaries
intersection <- st_intersection(acs_data, districts)

city_map <- st_join(intersection, city_boundaries, join = st_intersects)
```

This produces 524 fragments, that is geographic areas that are an intersection of tracts, districts, and city boundaries and inherit characteristics from their overlap.

So without some weighted estimates this multiplies the population by quite a bit as the population estimate is applied to each fragment the tract intersects with. 

Start by checking population of city v non-city
```{r}
desc_stats <- city_map |>
    mutate(fragment_area = st_area(geometry),
           pop_weight = fragment_area / tract_area,
           population = pop_weight * estimate,
           population_2022 = pop_weight * estimate_2022,
           population_2020 = pop_weight * estimate_2020) |>
    st_drop_geometry() 

#check that total population is close to equal
print(sum(desc_stats$population))
print(sum(acs_data$estimate))
```


This produces the high level estimates of percent of city population represented by Democrats (87%) and percent of county represented by Republicans (71%) 
```{r}
sum_stats <- desc_stats |>
    mutate(city = replace_na(SERVICE_DIST, "OUT")) |>
    group_by(city, Party_2024) |> 
    summarise(population = sum(population)) |>
    ungroup() |>
    group_by(city) |>
    mutate(pct = 100 * population / sum(population))
```

This runs it back to 2020, sort of. To do that properly we need 2020 acs data as well.  

```{r}
sum_stats_2020 <- desc_stats |>
    mutate(city = replace_na(SERVICE_DIST, "OUT")) |>
    group_by(city, Party_2020) |> 
    summarise(population_2020 = sum(population_2020)) |>
    ungroup() |>
    group_by(city) |>
    mutate(pct = 100 * population_2020 / sum(population_2020))

sum_stats_2022 <- desc_stats |>
    mutate(city = replace_na(SERVICE_DIST, "OUT")) |>
    group_by(city, Party_2022) |> 
    summarise(population_2022 = sum(population_2022)) |>
    ungroup() |>
    group_by(city) |>
    mutate(pct = 100 * population_2022 / sum(population_2022))
```


