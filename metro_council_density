labels <- paste0(districts_with_pop$COUNDIST, ":", scales::label_comma()(districts_with_pop$density))    


map <- leaflet(districts_with_pop) |>
    addTiles() |>
    addPolygons(
        fillColor = ~num_pal(density),
        color = "black",
        weight = 2,
        fillOpacity = 0.3,
        label = labels,
        labelOptions = labelOptions(textsize = "12px")
    ) 
    
 map <- map |>
    addGeosearch(provider = geosearchProvider("OSM"),
        options = geosearchOptions(style = "bar"))


map

```

```{r}
party_colors <- c("R" = "red", "D" = "blue", "I" = "light blue")

p <- ggplot(districts_with_pop, aes(x = reorder(COUNDIST, density), y = density, fill = Party_2024)) +
    geom_col() +
    coord_flip() +
    scale_fill_manual(values = party_colors, labels = c("Democrat", "Independent", "Republican")) +
    labs(title = "Democrats and Republicans are sorted by population density",
        x = "Council District",
        y = "Persons per Square Feet",
        fill = "Political Party") +
    theme_minimal() + 
    theme(plot.title = element_text(face = "bold", size = 14))

p
```


