## Pull in ACS population estimates since we want percent of population, not percent of land area

Pull tract level population data
```{r}
api_key <- readLines("census_api_key.txt", n = 1)
census_api_key(api_key, install = TRUE)

acs_data <- get_acs(
    state = "KY", 
    county = "Jefferson", 
    geography = "tract", 
    variables = c("B01001_001"), 
    geometry = TRUE, 
    year = 2024
    )
```

## City v County Calculations

Join the shapefiles

```{r}
districts <- st_transform(districts, crs = 3089)
city_boundaries <- st_transform(city_boundaries, crs = 3089)
acs_data <- st_transform(acs_data, crs = 3089)  # Kentucky State Plane (feet)


#Calculate area of each district, city, and tract
districts <- districts |>
    mutate(district_area = st_area(geometry))

city_boundaries <- city_boundaries |>
    mutate(city_area = st_area(geometry))

acs_data <- acs_data |>
  mutate(tract_area = st_area(geometry))

#Intersect them all with city boundaries
intersection <- st_intersection(acs_data, districts)

city_map <- st_join(intersection, city_boundaries, join = st_intersects)
```

This produces 524 fragments, that is geographic areas that are an intersection of tracts, districts, and city boundaries and inherit characteristics from their overlap.

So without some weighted estimates this multiplies the population by quite a bit as the population estimate is applied to each fragment the tract intersects with. 

Start by checking population of city v non-city
```{r}
desc_stats <- city_map |>
    mutate(fragment_area = st_area(geometry),
           pop_weight = fragment_area / tract_area,
           population = pop_weight * estimate) |>
    st_drop_geometry() 

#check that total population is close to equal
print(sum(desc_stats$population))
print(sum(acs_data$estimate))
```

```{r}
sum_stats <- desc_stats |>
    mutate(city = replace_na(SERVICE_DIST, "OUT")) |>
    group_by(city, Party_2024) |> 
    summarise(population = sum(population)) |>
    ungroup() |>
    group_by(city) |>
    mutate(pct = 100 * population / sum(population))
```

# Joined data

```{r}
# --- 1. Make sure both layers share the same CRS ---
# Use a projected CRS (not lat/lon) so area calculations are accurate
acs_data <- st_transform(acs_data, crs = 3089)  # Kentucky State Plane (feet)
districts <- st_transform(districts, crs = 3089)

# --- 2. Calculate the area of each census tract BEFORE intersecting ---
acs_data <- acs_data |>
  mutate(tract_area = st_area(geometry))

# --- 3. Intersect the two layers ---
# This creates fragments where each piece belongs to one tract AND one district
intersection <- st_intersection(acs_data, districts)

# --- 4. Calculate the area of each fragment ---
intersection <- intersection |>
  mutate(fragment_area = st_area(geometry))

# --- 5. Compute the area weight for each fragment ---
# weight = what fraction of the original tract this fragment represents
intersection <- intersection |>
  mutate(weight = as.numeric(fragment_area / tract_area))

# --- 6. Apply weights to population, then sum up by district ---
district_population <- intersection |>
  mutate(pop_estimate = estimate * weight) |>  
  st_drop_geometry() |>
  group_by(COUNDIST) |>  
  summarise(estimated_population = sum(pop_estimate, na.rm = TRUE))

# --- 7. Join back to the districts shapefile for mapping ---
districts_with_pop <- districts |>
  left_join(district_population, by = "COUNDIST")

# Calculate Density
districts_with_pop <- districts_with_pop |>
  mutate(
    area_sqmi = as.numeric(st_area(geometry)) / 27878400,  # convert sq feet to sq miles
    density = estimated_population / area_sqmi
  )
```

